# 로컬 실행용 예시. 이 파일을 .env 로 복사해 값을 채운다(.env 는 커밋되지 않는다).
# 실제 키 값은 여기에 적지 않는다 — 이 저장소는 공개 저장소다.

# --- 신규 (권장) : NAVER CLOUD PLATFORM > NAVER API HUB ---
# console.ncloud.com → Services → Application Service → NAVER API HUB
NCP_API_KEY_ID=
NCP_API_KEY=

# --- 레거시 : developers.naver.com (2026-07-31 신규 발급 종료, 기존 키는 2027-06-30까지) ---
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
