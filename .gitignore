.env
__pycache__/
*.pyc
.venv/

# 네이버 로그인 세션이 들어있는 브라우저 프로필.
# 저장소가 Public 이므로 이게 커밋되면 세션 쿠키가 전 세계에 공개된다.
# 절대 커밋하지 말 것.
.naver-profile/

# 디버그 스크린샷 (화면에 계정 정보가 찍힐 수 있음)
content/state/debug-*.png

# 비용 장부 (사용 패턴이 드러나므로 공개 저장소에는 올리지 않음)
content/state/cost_log.csv

# 사진 원본 (장당 3~12MB). 웹용(_web)만 저장소에 올린다.
content/photos/reboot/equipment/*
content/photos/reboot/facility/*
content/photos/reboot/class/*
content/photos/reboot/members/*
content/photos/reboot/misc/*
content/photos/teampoise/*/*
!content/photos/**/.gitkeep
content/photos/_thumb/
